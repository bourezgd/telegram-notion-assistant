{
  "root": true,
  "parserOptions": {
    "ecmaVersion": 2023,
    "sourceType": "module"
  },
  "env": {
    "es2022": true,
    "worker": true,
    "browser": true
  },
  "globals": {
    "console": "readonly"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "error",
      {
        "vars": "all",
        "args": "none",
        "caughtErrors": "none"
      }
    ]
  }
}
